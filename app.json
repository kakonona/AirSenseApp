{
  "expo": {
    "name": "AirSenseApp",
    "slug": "AirSenseApp",
    "version": "1.0.0",
    "sdkVersion": "58.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "airsenseapp",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "package": "com.naufal.airsense",
      "adaptiveIcon": {
        "backgroundColor": "#6B9E7E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": {
            "web": false
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#6B9E7E",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 160
          }
        }
      ],
      "expo-web-browser",
      "expo-font",
      "expo-sharing",
      [
        "expo-notifications",
        {
          "color": "#6B9E7E",
          "defaultChannel": "emergency-alerts"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Izinkan AirSense mengakses lokasi saat digunakan untuk mencatat lokasi kejadian darurat.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "@react-native-google-signin/google-signin/app.plugin.js",
      "./plugins/with-airsense-ble-service",
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": true,
          "neverForLocation": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": false
        }
      },
      "eas": {
        "projectId": "041c95b7-9ab6-404a-b54b-5fd6ec2fcf0f"
      }
    }
  }
}
