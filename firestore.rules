rules_version = '2';

// Aturan akses Firestore AirSense.
// Worker (wearable-alert-api) memakai service account sehingga tidak terikat aturan ini:
// push_tokens, invitations, dan notifikasi peringatan untuk kontak ditulis oleh Worker.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isUser(uid) { return signedIn() && request.auth.uid == uid; }
    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // username -> email. Dibaca SEBELUM login (login pakai username, cek username saat daftar).
    match /usernames/{name} {
      allow get: if true;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
    }

    // email -> { uid, name }: untuk menambahkan kontak darurat lewat email.
    match /emails/{email} {
      allow get: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn() && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
    }

    match /profile/{uid} {
      allow read, write: if isUser(uid);

      match /history/{id} {
        allow read, write: if isUser(uid);
      }
      match /notifications/{id} {
        allow read, write: if isUser(uid);
      }

      // Orang yang memantau saya. Kontak (contactId) boleh membaca entrinya sendiri dan
      // hanya mengubah status (terima / tolak).
      match /emergency_contacts/{contactId} {
        allow read, write: if isUser(uid);
        allow get: if isUser(contactId);
        allow update: if isUser(contactId) && onlyChanges(["status"])
          && request.resource.data.status in ["accepted", "rejected"];
      }

      // Orang yang saya pantau. Pemilik data (monitoringId) membuat permintaan dan boleh
      // menghapusnya saat mencabut akses.
      match /monitoring/{ownerUid} {
        allow read, update, delete: if isUser(uid);
        allow create, delete: if isUser(ownerUid);
        allow get: if isUser(ownerUid);
      }
    }
  }
}
